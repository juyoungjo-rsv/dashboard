# 세션 쿠키 서명에 사용하는 비밀 키. 반드시 무작위의 긴 문자열로 바꿔주세요.
# 생성 예시: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-long-random-string

# 계정 1 (기본값: 언니)
USER1_USERNAME=unni
USER1_PASSWORD=change-this-password
USER1_DISPLAY_NAME=언니

# 계정 2 (기본값: 동생)
USER2_USERNAME=dongsaeng
USER2_PASSWORD=change-this-password
USER2_DISPLAY_NAME=동생

# 위 계정 정보는 최초 실행 시 한 번만 데이터베이스에 저장됩니다.
# 이후에 값을 바꿔도 이미 생성된 계정에는 반영되지 않아요.

# ── 아래 두 개는 실제 서비스로 배포할 때만 필요해요 (로컬 개발 시엔 비워두면
# 알아서 로컬 파일에 저장돼요) ──
# Turso(무료 SQLite 호스팅)에서 데이터베이스를 만들면 발급되는 값들입니다.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel에서 프로젝트에 Blob 저장소를 연결하면 자동으로 채워지는 값이라
# 보통 직접 입력할 필요는 없어요. (로컬에서 사진 업로드를 테스트하고 싶을 때만
# Vercel 대시보드에서 값을 복사해 넣어주세요.)
BLOB_READ_WRITE_TOKEN=
